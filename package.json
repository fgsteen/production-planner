{
  "name": "production-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "npm run test:scripts && npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "session:start": "node scripts/session/cli.mjs start",
    "session:status": "node scripts/session/cli.mjs status",
    "session:end": "node scripts/session/cli.mjs end",
    "session:stats": "node scripts/session/cli.mjs stats"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
